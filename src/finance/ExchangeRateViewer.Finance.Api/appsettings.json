{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "ExchangeRateViewer.Finance.Api"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ExchangeRateViewer.Users",
    "Audience": "ExchangeRateViewer"
  }
}
