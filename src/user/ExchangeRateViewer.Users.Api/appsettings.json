{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "ExchangeRateViewer.Users.Api"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ExchangeRateViewer.Users",
    "Audience": "ExchangeRateViewer",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  }
}
